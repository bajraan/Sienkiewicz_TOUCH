				(color "Black")
				(thickness 0.02)
				(material "Solder Resist")
				(epsilon_r 3.3)
				(loss_tangent 0)
			)
			(layer "B.Paste"
				(type "Bottom Solder Paste")
			)
			(layer "B.SilkS"
